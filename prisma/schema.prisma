// The voidix content database.
//
// Two layers live here, and the distinction is the whole design:
//
//   1. The EDITING tables (services, projects, faq_entries + their ordered children).
//      These are the working draft. Editing them changes nothing on the live site.
//   2. content_releases — an append-only log of published snapshots. Pressing "Publish"
//      serialises the current draft into one JSON payload shaped exactly like the site's
//      TypeScript arrays. The site reads the newest release; the editor never sees it.
//
// That split is what makes the Publish button mean something: you can leave a half-written
// answer in the draft tables for a week and the site keeps serving the last release.
//
// Column widths are not defensive padding — they come from the layouts these strings land
// in (a four-across carousel row, a one-line kicker). See docs/admin-content-schema.md §7.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A discipline the studio sells, and the one vocabulary three places share.
///
/// The fleet sells a discipline, the works field shows a project OF one, and the enquiry form
/// arrives already knowing which one the visitor came from. The site keeps all three in step by
/// keying off a single `DisciplineId`; this table is that list.
///
/// ⚠ `label` is deliberately PLAINSPOKEN — "Web Development", not the deck's "Web Experiences".
/// The service name is the brand talking; this is the line a visitor would write in an email,
/// and it is what lands in the form's subject. Both exist on purpose.
///
/// `key` is what the site keys off and is never shown to a visitor, so it is not editable — a
/// renamed key would silently unbind every service and project from its CTA.
model Discipline {
  id        String @id @default(uuid()) @db.Uuid
  key       String @unique @db.VarChar(32)
  sortOrder Int    @map("sort_order")
  label     String @db.VarChar(60)
  /// Seeds the form's long field. In the VISITOR's voice and left mid-sentence — the trailing
  /// space is added on publish by `continuationSeed`, not typed here.
  briefSeed String @map("brief_seed") @db.VarChar(300)

  services Service[]
  projects Project[]

  @@index([sortOrder])
  @@map("disciplines")
}

/// Every string the site's shared enquiry form renders, other than the ones a section overrides.
///
/// ⚠ ONE FORM, SIX PLACES. `EnquiryForm` on the site is rendered by the services deck, the works
/// field, the FAQ hologram, the contact section, `/about` and `/careers`. These strings are the
/// ones common to all of them, which is why they live here rather than on the contact section —
/// putting them there would say they were contact's, and the next editor would wonder why
/// changing them moved the works form too.
///
/// What a section overrides stays with that section: `contact_section.brief_label` and
/// `careers_page.application_brief_label` name the long field differently because those two
/// forms ask a different question.
model EnquiryFormContent {
  id String @id

  nameLabel  String @map("name_label") @db.VarChar(60)
  emailLabel String @map("email_label") @db.VarChar(60)
  phoneLabel String @map("phone_label") @db.VarChar(60)

  /// While the request is in flight. Replaces the button's own label, so it reads as the same
  /// control doing something rather than a different one appearing.
  sendingLabel String @map("sending_label") @db.VarChar(40)
  sentMessage  String @map("sent_message") @db.VarChar(200)
  errorMessage String @map("error_message") @db.VarChar(200)

  /// How the works field's CTA names the project the visitor is pointing at. Both must contain
  /// `{project}`; the schema rejects them if they don't, because a template that silently drops
  /// its only variable produces copy that reads as finished and says nothing.
  referenceSubjectSuffix String @map("reference_subject_suffix") @db.VarChar(60)
  referenceBriefPrefix   String @map("reference_brief_prefix") @db.VarChar(120)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("enquiry_form_content")
}

/// A service = one vessel on the ServicesDeck carousel. Text only.
///
/// Deliberately has no create/delete path in the admin UI: a service is bound to a .glb
/// model, a hull palette, and a placement entry in the site's deckTuning.ts that is keyed by
/// ARRAY POSITION. Adding one needs a model authored and tuned; reordering or deleting one
/// silently rebinds every ship's placement to the wrong vessel. `slug` exists so the site can
/// later key off a stable id instead of position — that refactor is the prerequisite for ever
/// making this list reorderable.
model Service {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable identity the site can key placement data off. Never shown to visitors.
  slug        String   @unique @db.VarChar(64)
  /// Position in the deck. Renders as the "01".."04" ordinal — derived, never typed.
  sortOrder   Int      @map("sort_order")
  /// Short label in the bottom carousel strip. Four of these sit in one row.
  name        String   @db.VarChar(80)
  /// One-line poetic kicker above the description.
  eyebrow     String   @db.VarChar(120)
  description String
  /// What this craft's CTA enquires about. Separate from `name` on purpose — the name is the
  /// brand talking, the discipline is the plain word that lands in the form's subject.
  disciplineId String   @map("discipline_id") @db.Uuid
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  capabilities ServiceCapability[]

  @@index([sortOrder])
  @@map("services")
}

/// Tag chips under a service description. Ordered, individually rendered.
model ServiceCapability {
  id        String @id @default(uuid()) @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sortOrder Int    @map("sort_order")
  label     String @db.VarChar(40)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_capabilities")
}

/// A project in the Works field. Free to add, remove and reorder.
///
/// ⚠ The caveat that used to be recorded here — that an added project "renders with the global
/// fallback rock", so several additions read as the same body repeated — described the METEOR era
/// and stopped being true when the site's accretion strategy landed. The body IS the mark now: it
/// is cut from this project's own uploaded SVG, and a project with no upload grows its own INITIAL
/// instead. Two projects can only look alike if they share a first letter.
///
/// The camera pose is no longer hand-authored per project either — the site generates its path from
/// however many projects exist. Adding one is a content decision again, not a developer task.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(64)
  sortOrder   Int      @map("sort_order")
  title       String   @db.VarChar(80)
  /// Who it was built for, or the context. Renders as "{client} · {year}".
  client      String   @db.VarChar(120)
  /// A string, not an integer — the site renders it raw and allows things like "2026".
  year        String   @db.VarChar(8)
  description String
  /// The kind of work this was, from the same vocabulary the fleet sells. Renders as the
  /// project's type key and decides what its CTA enquires about.
  disciplineId String     @map("discipline_id") @db.Uuid
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)

  /// The project's MARK — the logo the works field cuts into interlocking stones.
  ///
  /// ⚠ Published, but never rendered as a link. The site's SERVER dereferences this during ISR and
  /// hands the page the SVG source; a visitor's browser never sees this URL. That is deliberate and
  /// it is not about the file: a `<project-ref>.supabase.co` address in the page would advertise
  /// where the leads database lives, which is the one thing the site's intake proxy exists to avoid.
  ///
  /// Null is a first-class state, not a missing value — the site grows the project's INITIAL.
  markSvgUrl      String? @map("mark_svg_url") @db.VarChar(500)
  /// The object's path inside the bucket.
  ///
  /// Kept alongside the URL, and NOT published, because a public URL is not a handle you can delete
  /// by. Without this, replacing a mark twice leaves two orphans in the bucket that nothing knows
  /// the name of.
  markStoragePath String? @map("mark_storage_path") @db.VarChar(200)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tags ProjectTag[]

  @@index([sortOrder])
  @@map("projects")
}

/// Capability / tech chips under a project description. Ordered.
model ProjectTag {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  sortOrder Int    @map("sort_order")
  label     String @db.VarChar(40)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_tags")
}

/// A question in the Chamber hologram. The freest section in the system — the hologram
/// measures its own content and moves its frames to fit, so length and count cost nothing.
model FaqEntry {
  id        String   @id @default(uuid()) @db.Uuid
  sortOrder Int      @map("sort_order")
  question  String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paragraphs FaqParagraph[]

  @@index([sortOrder])
  @@map("faq_entries")
}

/// One paragraph of an answer. The site renders each as its own <p>, so this is a child
/// table rather than one blob with newlines in it.
model FaqParagraph {
  id         String @id @default(uuid()) @db.Uuid
  faqEntryId String @map("faq_entry_id") @db.Uuid
  sortOrder  Int    @map("sort_order")
  body       String

  entry FaqEntry @relation(fields: [faqEntryId], references: [id], onDelete: Cascade)

  @@index([faqEntryId, sortOrder])
  @@map("faq_paragraphs")
}

/// The Contact section's copy.
///
/// A singleton — there is only ever one contact section, so it uses a fixed primary key
/// (`SINGLETON_ROW_ID`) and is written with `upsert` rather than create/update. That is
/// simpler and safer than a table that could accidentally hold two rows and leave the site
/// picking one arbitrarily.
///
/// ⚠ RESHAPED ONCE THE SITE'S CONTACT SECTION ACTUALLY EXISTED, and the shape it lost is worth
/// remembering. This table was designed before the section was built and guessed wrong in five
/// places: a two-line title (the site renders ONE string), an eyebrow (hardcoded in JSX, and in
/// two places), a standalone email address (it is a link inside the footer's `Direct` group),
/// three form field labels and a success/error pair (all hardcoded in `EnquiryForm.tsx`).
/// Every one of those would have been a field an editor could fill in that rendered nowhere.
/// What is left is exactly what `contactContent.ts` exports plus the two real form props.
model ContactSection {
  id String @id

  /// ⚠ One string. The site's `CONTACT_TITLE` is not split across lines the way the section
  /// titles elsewhere are — do not "restore" the two-column version.
  title String @db.VarChar(120)
  lead  String

  /// Names the form's long field. A real prop on EnquiryForm, so the site can read it today.
  briefLabel  String @map("brief_label") @db.VarChar(60)
  submitLabel String @map("submit_label") @db.VarChar(40)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("contact_section")
}

/// Footer sign-off copy. Singleton, same as ContactSection.
///
/// ⚠ Neither string is read by the site yet — both are hardcoded in `PageFooter.tsx`. They are
/// carried here because they are plainly copy and only their source has to move; the panel says
/// so on the page rather than letting an editor believe an edit here changes the site.
model FooterContent {
  id String @id

  /// The line under the wordmark ("Software with its own gravity").
  tagline String @db.VarChar(120)
  /// The line across the bottom. Not a copyright notice — the site's is a statement of what the
  /// studio is, with no year in it, so nothing here needs editing every January.
  signOff String @map("sign_off") @db.VarChar(160)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("footer_content")
}

/// A titled column of footer links.
///
/// ⚠ ONE LIST FEEDS TWO FOOTERS. The site's `CONTACT_FOOTER_GROUPS` is rendered both by the
/// homepage's contact section and by `PageFooter` on the document routes — deliberately, so a
/// changed handle cannot land in one footer and not the other. The consequence for an editor is
/// that the two have very different space budgets: the contact footer shares one pinned viewport
/// with a form and a black hole, and the site has a whole `@media (max-width: 30em)` block about
/// the ~150px it once overran by. A change here wants checking on a 360px phone.
///
/// This replaced the old `footer_social_links` / `footer_legal_links` split, which could not
/// express a group title at all.
model FooterLinkGroup {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  /// The small uppercase kicker over the column.
  title     String @db.VarChar(40)

  links FooterLink[]

  @@index([sortOrder])
  @@map("footer_link_groups")
}

/// One link inside a group. Ordered within its group.
///
/// There is no `is_external` column: the site's flag is derivable from the href, and a stored
/// copy could disagree with it. `contentPayload` computes it — an `http(s)` destination opens in
/// a new tab, a root-relative path or a `mailto:` does not, which is exactly what the site's
/// hand-maintained array says today.
model FooterLink {
  id        String @id @default(uuid()) @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sortOrder Int    @map("sort_order")
  label     String @db.VarChar(60)
  href      String @db.VarChar(500)

  group FooterLinkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@map("footer_links")
}

// ─── The document pages: /about and /careers ────────────────────────────────────────────────
//
// These two are shaped differently from the five sections above, and the difference is worth
// stating once. Services, Works and FAQ are each ONE repeating thing. A document page is a
// masthead plus several unrelated ordered lists, so each is a singleton for the prose with
// standalone ordered tables beside it — the same arrangement FooterContent already uses with
// its two link tables, and for the same reason: the lists have no parent row to hang off.
//
// ⚠ WHAT IS DELIBERATELY NOT HERE: the numbered section list (the site's ABOUT_SECTIONS /
// CAREERS_SECTIONS). Each entry's `key` is both the section's anchor id and the station the
// orbit rail scrolls to, so it is structure, not copy — an editor renaming one would break
// in-page navigation with nothing to catch it. It stays in the site's source.

/// The `/about` document's prose. Singleton, same reasoning as ContactSection.
model AboutPage {
  id String @id

  eyebrow String @db.VarChar(60)
  /// Two lines, not one string with a break in it — see ContactSection's title columns.
  titleLine1 String @map("title_line_1") @db.VarChar(60)
  titleLine2 String @map("title_line_2") @db.VarChar(60)
  lead       String

  /// The pull quote closing the premise section.
  premiseQuote String @map("premise_quote")

  instrumentsNote String @map("instruments_note")
  stackNote       String @map("stack_note")

  closingTitle String @map("closing_title") @db.VarChar(80)
  closingLead  String @map("closing_lead")

  /// The cross-link to /careers. Both document pages carry one to the other.
  careersInvite String @map("careers_invite") @db.VarChar(120)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("about_page")
}

/// Paragraphs of the premise section. One row per `<p>`, like FaqParagraph.
model AboutPremiseParagraph {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  body      String

  @@index([sortOrder])
  @@map("about_premise_paragraphs")
}

/// The studio's principles. A `Claim` on the site: an assertion and the thing backing it up.
model AboutPrinciple {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  claim     String @db.VarChar(80)
  backing   String

  @@index([sortOrder])
  @@map("about_principles")
}

/// How a build runs, as a `Phase` on the site: a span of time, its name, what happens in it.
model AboutBuildPhase {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  span      String @db.VarChar(40)
  name      String @db.VarChar(40)
  detail    String

  @@index([sortOrder])
  @@map("about_build_phases")
}

/// The instruments.
///
/// ⚠ These are COMMITMENTS, not measurements, and the site's aboutContent.ts is arranged around
/// keeping them that way — "37 products shipped" is precisely the sentence that file avoids.
/// Nothing here can enforce that; it is a rule for whoever edits them.
model AboutInstrument {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  label     String @db.VarChar(40)
  value     String @db.VarChar(40)

  @@index([sortOrder])
  @@map("about_instruments")
}

/// What the studio works in. Ordered chips.
model AboutStackItem {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  label     String @db.VarChar(40)

  @@index([sortOrder])
  @@map("about_stack_items")
}

/// The `/careers` document's prose, including the strings its application form renders.
model CareersPage {
  id String @id

  eyebrow    String @db.VarChar(60)
  titleLine1 String @map("title_line_1") @db.VarChar(60)
  titleLine2 String @map("title_line_2") @db.VarChar(60)
  lead       String

  /// What the roles section says when no role is open. The page has to stand in that state,
  /// so this is required copy rather than something to fill in later.
  rolesEmptyLine   String @map("roles_empty_line") @db.VarChar(200)
  rolesEmptyInvite String @map("roles_empty_invite") @db.VarChar(60)

  openApplicationTitle   String @map("open_application_title") @db.VarChar(80)
  openApplicationLead    String @map("open_application_lead")
  /// Carried in place of a role title when someone applies without one.
  openApplicationSubject String @map("open_application_subject") @db.VarChar(60)
  /// Seeds the long field, in the APPLICANT's voice and left mid-sentence.
  openApplicationSeed    String @map("open_application_seed") @db.VarChar(200)
  /// ⚠ Asked only on the open application — a posted role already states its own terms.
  commitmentLabel        String @map("commitment_label") @db.VarChar(60)

  applicationBriefLabel  String @map("application_brief_label") @db.VarChar(60)
  applicationSubmitLabel String @map("application_submit_label") @db.VarChar(40)

  /// The cross-link to /about.
  aboutInvite String @map("about_invite") @db.VarChar(120)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("careers_page")
}

/// What it is like to work here. Same `Claim` shape as AboutPrinciple — the site shares one
/// type across both pages, so the two tables carry the same columns and the same limits.
model CareersClaim {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  claim     String @db.VarChar(80)
  backing   String

  @@index([sortOrder])
  @@map("careers_working_here")
}

/// How hiring runs. Same `Phase` shape as AboutBuildPhase.
model CareersHiringPhase {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  span      String @db.VarChar(40)
  name      String @db.VarChar(40)
  detail    String

  @@index([sortOrder])
  @@map("careers_hiring_phases")
}

/// What an open applicant can say they are looking for. Ordered, because it renders as a
/// choice list and the order is the order they are offered in.
model CareersCommitmentOption {
  id        String @id @default(uuid()) @db.Uuid
  sortOrder Int    @map("sort_order")
  label     String @db.VarChar(40)

  @@index([sortOrder])
  @@map("careers_commitment_options")
}

/// One open role. Free to add, remove and reorder — this is the table the whole careers page
/// was handed to the panel for, and the roles shipped in the site's source are placeholders
/// describing no vacancy that exists.
///
/// An empty list is a valid, designed state: the page renders `rolesEmptyLine` on its own.
model CareerRole {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique @db.VarChar(64)
  sortOrder  Int      @map("sort_order")
  title      String   @db.VarChar(100)
  /// Decided PER ROLE — remote, hybrid or in the studio, whichever that opening needs. Not a
  /// studio-wide policy, which is why it lives here rather than in the page's lead.
  location   String   @db.VarChar(60)
  commitment String   @db.VarChar(60)
  /// Seeds the application form's long field, in the applicant's voice, left mid-sentence.
  briefSeed  String   @map("brief_seed") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bullets CareerRoleBullet[]
  /// Applications for this role. They outlive it — deleting a role sets this null on each and
  /// leaves the title snapshot behind.
  applications CareerApplication[]

  @@index([sortOrder])
  @@map("career_roles")
}

/// Which of a role's three lists a bullet belongs to.
enum CareerRoleBulletKind {
  /// What the person would be responsible for.
  OWNS
  /// What we would need to see to take the application seriously.
  NEEDS
  /// Genuinely optional, and labelled as such — "nice to have" lists are why good people
  /// don't apply.
  BONUS

  @@map("career_role_bullet_kind")
}

/// A line in one of a role's three lists.
///
/// One table with a `kind` rather than three identical ones, which is the opposite of the call
/// made for the footer's social and legal links — and the difference is where they render. The
/// footer's two lists appear in different places on the page, so splitting them cost nothing
/// and a `kind` column would have duplicated the split. These three appear in the same card,
/// in the same shape, differing only by the heading above them; three identical tables would
/// mean three identical models and three identical write paths.
model CareerRoleBullet {
  id        String               @id @default(uuid()) @db.Uuid
  roleId    String               @map("role_id") @db.Uuid
  kind      CareerRoleBulletKind
  sortOrder Int                  @map("sort_order")
  label     String

  role CareerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId, kind, sortOrder])
  @@map("career_role_bullets")
}

// ─── What the website sends, before anyone has decided it is worth anything ─────────────────
//
// ⚠ THESE ARE NOT LEADS, AND THAT IS THE POINT. A website submission used to become a `Contact`
// the instant it arrived, which meant every bot, every test post and every "hi" landed in the
// pipeline, in the counts, and in the reports. Now the public endpoints write here, and nothing
// becomes a Contact until an admin presses the button. Spam is deleted from a table nothing else
// reads rather than filtered out of one that everything reads.
//
// The consequence worth knowing: `visibility.ts` does not apply to either table, because neither
// has an owner. They are admin-only for exactly that reason — there is no per-person scoping to
// fall back on, so the gate is the role.

/// One submission of the site's enquiry form, exactly as it arrived.
///
/// Kept after promotion rather than deleted: this row is the record of what the visitor actually
/// typed and when, and the Contact it became is an edited, owned, worked version of it. The link
/// between them is `promotedContactId`.
///
/// ⚠ `email` is NOT unique here, unlike `contacts.email`. Deduplication is a decision about
/// people, and this table holds messages — the same person enquiring three times is three
/// submissions and, after promotion, one contact with three enquiries.
model Submission {
  id      String  @id @default(uuid()) @db.Uuid
  /// Stored lowercased via `normaliseEmail`, so matching against `contacts.email` on promotion
  /// compares like with like. The uniqueness that matters is enforced over there, not here.
  email   String  @db.VarChar(320)
  /// ⚠ NULLABLE, because the site's form asks for exactly one thing — the email address. Everything
  /// else there is an invitation, deliberately: a required-field wall in front of a first message
  /// costs more conversations than a tidier inbox is worth. `promoteSubmission` fills a missing one
  /// from the address, the same readable guess the spreadsheet importer makes.
  name    String? @db.VarChar(120)
  company String? @db.VarChar(120)
  /// ⚠ Nullable for the same reason as `name`. An address with no message is still someone asking
  /// to be contacted, and `enquiries.message` was already nullable, so it promotes cleanly.
  message String?
  /// The site's form asks for a mobile and validates it. Without this column it arrived here and
  /// was dropped in silence — an enquiry is not a lesser record than an application.
  phone   String? @db.VarChar(40)

  /// What the site called this form — a page, a campaign, a discipline. Becomes the contact's
  /// `origin_label` on promotion.
  ///
  /// ⚠ 120, not 40: it carries the form's subject, which names a discipline and, from the works
  /// field, the project being pointed at — "Artificial Intelligence — like Halcyon".
  source String? @db.VarChar(120)

  /// Salted hash only, never the address itself — same rule as `Enquiry`.
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Null while it is still in the inbox. Set when it becomes, or joins, a contact.
  promotedAt        DateTime?   @map("promoted_at") @db.Timestamptz(6)
  promotedContactId String?     @map("promoted_contact_id") @db.Uuid
  promotedContact   Contact?    @relation(fields: [promotedContactId], references: [id], onDelete: SetNull)
  promotedById      String?     @map("promoted_by_id") @db.Uuid
  promotedBy        TeamMember? @relation("SubmissionPromoter", fields: [promotedById], references: [id], onDelete: SetNull)

  /// Junk, marked rather than deleted so the same sender can be recognised and so the inbox can
  /// show what it has already dealt with. A real delete stays available for anything worse.
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(6)

  // Pending rows are what the inbox opens on, so that is the index that has to be fast.
  @@index([promotedAt, dismissedAt, createdAt])
  @@index([email])
  @@map("submissions")
}

/// Someone applying for a job.
///
/// ⚠ Emphatically not a lead and never promoted into one. A candidate is not a prospect, the two
/// have opposite relationships to the studio, and a CV is far more sensitive than an enquiry.
/// Nothing here touches `contacts`.
model CareerApplication {
  id    String  @id @default(uuid()) @db.Uuid
  name  String  @db.VarChar(120)
  email String  @db.VarChar(320)
  phone String? @db.VarChar(40)
  /// The applicant's answer to "why you" — the long field.
  whyYou String @map("why_you")

  /// A portfolio, a repository, a piece of writing.
  workLink String? @map("work_link") @db.VarChar(500)
  /// The CV, uploaded by the SITE to UploadThing, which sends us the resulting URL. No file ever
  /// reaches this database — it stores a link like any other.
  cvUrl    String? @map("cv_url") @db.VarChar(500)

  /// The role applied for, or null for an open application.
  ///
  /// ⚠ `roleTitle` is a SNAPSHOT and is why the relation may go null. A role is deleted when it
  /// closes — that is the designed way to close one — and an application must still say what it
  /// was for a year later. Same rule as `ContactAttempt`: store the words, not just the pointer.
  roleId    String?     @map("role_id") @db.Uuid
  role      CareerRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleTitle String      @map("role_title") @db.VarChar(100)

  /// What they are looking for. Asked only on open applications — a posted role already states
  /// its own terms, so this is null for those.
  commitment String? @db.VarChar(40)

  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// When somebody actually read it. An inbox with no read/unread distinction is a pile.
  reviewedAt   DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  reviewedById String?     @map("reviewed_by_id") @db.Uuid
  reviewedBy   TeamMember? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reviewedAt, createdAt])
  @@index([roleId])
  @@map("career_applications")
}

/// Whether a stage still counts as live pipeline.
///
/// The reason stages aren't just an ordered list of words: something has to know that "Won" and
/// "Lost" end the conversation. Without it, "how many open leads?" becomes a guess based on
/// position in the list, and a closed lead keeps asking to be followed up.
enum StageKind {
  OPEN
  WON
  LOST

  @@map("stage_kind")
}

/// A step in the sales pipeline. Editable vocabulary, like the attempt channels and outcomes —
/// the right words depend on how a particular team sells.
///
/// Retired rather than deleted, and never deleted while contacts point at it (the FK is
/// `Restrict`). `contact_stage_changes` snapshots the label as text, so renaming a stage leaves
/// history intact.
model PipelineStage {
  id        String    @id @default(uuid()) @db.Uuid
  sortOrder Int       @map("sort_order")
  label     String    @unique @db.VarChar(60)
  kind      StageKind @default(OPEN)
  isActive  Boolean   @default(true) @map("is_active")

  contacts Contact[]

  @@index([sortOrder])
  @@map("pipeline_stages")
}

enum TeamRole {
  /// Everything: site copy, publishing, leads, and managing the team.
  ADMIN
  /// Leads only. Cannot read or edit site copy, cannot publish, cannot delete a contact.
  SALES

  @@map("team_role")
}

/// Someone who can log in.
///
/// Mirrors a Supabase Auth user rather than replacing it — Auth still owns passwords and
/// sessions; this row owns the role and the display name. It exists because roles need to be
/// queryable (to list who a contact can be assigned to) and Auth's user table is not readable
/// from the app without the service role key.
///
/// Linked by `email` on first sign-in, which is why the email here must match the one the
/// account was created with.
model TeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  /// Supabase `auth.users.id`, filled in the first time this person signs in.
  authUserId String?  @unique @map("auth_user_id") @db.Uuid
  email      String   @unique @db.VarChar(320)
  name       String   @db.VarChar(120)
  role       TeamRole @default(SALES)
  /// Revokes access without deleting the row, so their name still renders on contacts they
  /// used to own. Deleting the person would orphan that history.
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedContacts Contact[]           @relation("ContactAssignee")
  /// Leads this person put into the system, which is not the same set as the ones they own —
  /// an importer rarely keeps what they upload, and an admin adding a lead may hand it straight on.
  originatedContacts Contact[]         @relation("ContactOrigin")
  importBatches    ImportBatch[]
  attempts         ContactAttempt[]
  stageChanges     ContactStageChange[]
  promotedSubmissions  Submission[]        @relation("SubmissionPromoter")
  reviewedApplications CareerApplication[] @relation("ApplicationReviewer")

  @@map("team_members")
}

/// A person. One row per human, identified by email.
///
/// This is the half of the old flat `Lead` table that describes *who* — everything about
/// their approaches lives in `Enquiry`. Splitting the two is what makes duplicates
/// structurally impossible: a second contact-form submission from the same address is another
/// enquiry on this row, not a competing copy of it. That matters most once contacts are
/// assigned to individual salespeople, because two rows for one human means two owners.
model Contact {
  id      String  @id @default(uuid()) @db.Uuid
  /// Stored lowercased and trimmed — the unique index is what enforces one row per person, so
  /// casing must be normalised before it reaches the database.
  email   String  @unique @db.VarChar(320)
  name    String  @db.VarChar(120)
  company String? @db.VarChar(120)
  /// Imported prospect lists almost always carry one, and a sales team needs it.
  phone   String? @db.VarChar(40)

  /// Where they are in the pipeline. Replaced the old NEW/READ/ARCHIVED status, which described
  /// an inbox rather than a sales process and had no room for "qualified" or "lost".
  stageId String        @map("stage_id") @db.Uuid
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  /// Hides someone from the working list without deleting them. The everyday alternative to a
  /// real delete, which stays admin-only and takes their whole history with it.
  isArchived Boolean @default(false) @map("is_archived")

  /// When someone should next be chased. One date rather than a task list: the attempts
  /// timeline already records what actually happened, and a plain column sorts and filters
  /// without a subquery — which matters because the leads table pages in the database.
  nextFollowUpAt DateTime? @map("next_follow_up_at") @db.Timestamptz(6)

  /// Internal working notes. Never leaves the panel.
  notes String?

  assignedToId String?     @map("assigned_to_id") @db.Uuid
  assignedTo   TeamMember? @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?   @map("assigned_at") @db.Timestamptz(6)

  /// How this person got into the system, recorded once when their row is created and never
  /// rewritten.
  ///
  /// Not the same question as `Enquiry.source`, which answers it per approach: someone imported
  /// from a list in March and then filling in the website form in June has two enquiries with
  /// different sources, but they were still *added* by the import. Denormalised onto the contact
  /// rather than derived from the earliest enquiry because the leads table sorts, filters and
  /// pages on it in the database — deriving it would mean a subquery per row, and the reports
  /// would have to group over "earliest enquiry per contact" instead of one indexed column.
  ///
  /// The enum is shared with `Enquiry` on purpose. A second, parallel list of the same three
  /// words is a list that eventually disagrees with the first.
  originSource EnquirySource @map("origin_source")
  /// Who put them here. Null for the website form, where nobody did.
  originMemberId String?     @map("origin_member_id") @db.Uuid
  originMember   TeamMember? @relation("ContactOrigin", fields: [originMemberId], references: [id], onDelete: SetNull)
  /// Snapshot of their name, for the same reason `contact_attempts.member_name` is one: removing
  /// a team member must not turn "added by Sara" into "added by nobody".
  originMemberName String?      @map("origin_member_name") @db.VarChar(120)
  /// The spreadsheet they arrived in. Only ever set when `originSource` is IMPORT.
  originBatchId    String?      @map("origin_batch_id") @db.Uuid
  originBatch      ImportBatch? @relation(fields: [originBatchId], references: [id], onDelete: SetNull)
  /// The free-text label the website form passed with the submission — a page name, a campaign.
  /// Only ever set when `originSource` is CONTACT_FORM, and only when the site bothers to send it.
  originLabel      String?      @map("origin_label") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  enquiries         Enquiry[]
  attempts          ContactAttempt[]
  stageChanges      ContactStageChange[]
  customFieldValues ContactFieldValue[]
  /// The website submissions that became, or joined, this person.
  submissions       Submission[]

  @@index([stageId, createdAt])
  @@index([assignedToId, stageId])
  @@index([isArchived, nextFollowUpAt])
  /// The three shapes the Source filter and the reports query: by channel, by spreadsheet, and
  /// by the person who added them.
  @@index([originSource, createdAt])
  @@index([originBatchId])
  @@index([originMemberId])
  @@map("contacts")
}

enum EnquirySource {
  /// Arrived through POST /api/leads from the site's form.
  CONTACT_FORM
  /// Typed in by an admin.
  MANUAL
  /// Appeared in an uploaded spreadsheet.
  IMPORT

  @@map("enquiry_source")
}

/// One touchpoint with a contact: a form submission, a manual entry, or an appearance in an
/// imported list. Append-only in practice — this is the history that makes "third time they've
/// reached out" visible instead of hidden.
model Enquiry {
  id        String  @id @default(uuid()) @db.Uuid
  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  source  EnquirySource
  /// What they actually said. Null for import events, which carry no message.
  message String?

  importBatchId String?      @map("import_batch_id") @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  /// Only ever set for CONTACT_FORM. Salted hash, never a raw address — see the intake module.
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contactId, createdAt])
  @@index([ipHash, createdAt])
  @@map("enquiries")
}

/// A logged attempt to reach a contact — a call, an email, a meeting.
///
/// Separate from `Enquiry` because the direction is opposite: an enquiry is them reaching us,
/// an attempt is us reaching them. Mixing the two would make "have we chased this lead?"
/// unanswerable.
///
/// `channel` and `outcome` are stored as text snapshots rather than foreign keys into the
/// editable vocabulary. An admin renaming "Spoke" to "Spoke — interested" later must not
/// silently rewrite what someone recorded last month.
model ContactAttempt {
  id        String  @id @default(uuid()) @db.Uuid
  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Who made the attempt. Kept even if they leave the team, so history stays attributable.
  memberId   String?     @map("member_id") @db.Uuid
  member     TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Snapshot of their name, so a deleted member doesn't turn history anonymous.
  memberName String      @map("member_name") @db.VarChar(120)

  channel String  @db.VarChar(40)
  outcome String  @db.VarChar(60)
  note    String?

  /// The follow-up date promised *at the time of this attempt*.
  ///
  /// `contacts.next_follow_up_at` holds only the current one, and rescheduling overwrites it.
  /// Keeping the promise on the attempt means the timeline can still say "said they'd decide by
  /// 12 July" after the date has moved twice.
  nextDueAt DateTime? @map("next_due_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The stage move this attempt caused, if it caused one.
  stageChange ContactStageChange?

  @@index([contactId, createdAt])
  @@index([memberId, createdAt])
  @@map("contact_attempts")
}

/// One move between pipeline stages. Append-only.
///
/// A separate table rather than two columns on `contact_attempts` because a lead can be moved
/// without anybody phoning them — from the table's bulk actions, or the stage bar on the detail
/// page. Recording it only alongside an attempt would lose exactly those moves, and
/// "when did this become Qualified?" is the question a pipeline gets asked.
///
/// `fromStage` / `toStage` are text snapshots for the same reason `contact_attempts.channel` is:
/// renaming a stage must not rewrite what happened last month.
model ContactStageChange {
  id        String  @id @default(uuid()) @db.Uuid
  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  memberId   String?     @map("member_id") @db.Uuid
  member     TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberName String      @map("member_name") @db.VarChar(120)

  /// Null on the very first move, which is the lead arriving rather than being moved.
  fromStage String? @map("from_stage") @db.VarChar(60)
  toStage   String  @map("to_stage") @db.VarChar(60)
  reason    String?

  /// Set when the move came out of the follow-up wizard, so the two render as one event rather
  /// than two entries a second apart. Unique because one attempt moves a lead at most once.
  attemptId String?         @unique @map("attempt_id") @db.Uuid
  attempt   ContactAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contactId, createdAt])
  @@index([memberId, createdAt])
  @@map("contact_stage_changes")
}

/// The editable vocabulary for logging an attempt. Two small ordered lists rather than
/// enums, because the right words depend on how a particular team sells.
model AttemptChannel {
  id        String  @id @default(uuid()) @db.Uuid
  sortOrder Int     @map("sort_order")
  label     String  @unique @db.VarChar(40)
  isActive  Boolean @default(true) @map("is_active")

  @@index([sortOrder])
  @@map("attempt_channels")
}

model AttemptOutcome {
  id        String  @id @default(uuid()) @db.Uuid
  sortOrder Int     @map("sort_order")
  label     String  @unique @db.VarChar(60)
  isActive  Boolean @default(true) @map("is_active")

  @@index([sortOrder])
  @@map("attempt_outcomes")
}

enum CustomFieldKind {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  CHECKBOX
  URL
  SINGLE_SELECT
  MULTI_SELECT

  @@map("custom_field_kind")
}

/// An extra thing this team wants to record about a person, defined by an admin at runtime.
///
/// The alternative was adding columns to `contacts` for every request, which needs a developer
/// and a migration each time. A definition table means "Industry", "Budget" and "Campaign" are
/// data, not schema.
///
/// Retired, never deleted — the values stay, and re-enabling brings them back. That is how every
/// other vocabulary in this system behaves, and it means no admin can destroy 200 people's data
/// with one mis-click.
model ContactFieldDefinition {
  id        String          @id @default(uuid()) @db.Uuid
  /// Stable slug. Lets an export or an import mapping refer to a field by something other than
  /// its display label, which an admin may rename at any time.
  key       String          @unique @db.VarChar(64)
  label     String          @db.VarChar(60)
  kind      CustomFieldKind
  /// Only meaningful for SINGLE_SELECT and MULTI_SELECT. Empty for every other kind.
  options   String[]
  helpText  String?         @map("help_text") @db.VarChar(200)
  sortOrder Int             @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  values ContactFieldValue[]

  @@index([sortOrder])
  @@map("contact_field_definitions")
}

/// One custom field's value for one person.
///
/// Typed columns rather than a single text blob, because the leads table sorts on these: a text
/// column would order 9 after 10 and "12 Aug" after "1 Jan". Exactly one of them is populated,
/// chosen by the definition's `kind`.
///
/// Cascades from the contact — an erasure request has to take these with it.
model ContactFieldValue {
  id        String  @id @default(uuid()) @db.Uuid
  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  definitionId String                 @map("definition_id") @db.Uuid
  definition   ContactFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  valueText    String?   @map("value_text")
  valueNumber  Decimal?  @map("value_number") @db.Decimal(18, 4)
  /// A calendar date, not an instant — `@db.Date` so a renewal date can't shift a day when the
  /// server and the reader disagree about timezone.
  valueDate    DateTime? @map("value_date") @db.Date
  valueBoolean Boolean?  @map("value_boolean")
  valueOptions String[]  @map("value_options")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// One value per field per person. This is what makes a value a fact about someone rather
  /// than an append-only pile the UI has to pick a winner from.
  @@unique([contactId, definitionId])
  /// One index per sortable column — the table orders by these with a definition_id filter.
  @@index([definitionId, valueText])
  @@index([definitionId, valueNumber])
  @@index([definitionId, valueDate])
  @@map("contact_field_values")
}

enum AutoAssignMode {
  /// New website leads arrive with no owner and wait for an admin.
  UNASSIGNED
  /// Rotate through active sales members in name order.
  ROUND_ROBIN
  /// Always the same person.
  FIXED

  @@map("auto_assign_mode")
}

/// How lead management behaves. Singleton, like ContactSection and FooterContent.
///
/// These are settings rather than constants because they encode team policy, not layout
/// facts — the right answer differs between teams and changes as one grows.
model LeadSettings {
  id String @id

  autoAssignMode       AutoAssignMode @default(UNASSIGNED) @map("auto_assign_mode")
  autoAssignMemberId   String?        @map("auto_assign_member_id") @db.Uuid
  /// Round-robin pointer: who got the last one. Persisted because the rotation has to
  /// survive a restart, and a serverless instance has no memory of the previous request.
  lastAssignedMemberId String?        @map("last_assigned_member_id") @db.Uuid

  salesCanEditContact       Boolean @default(true) @map("sales_can_edit_contact")
  salesCanClaimUnassigned   Boolean @default(false) @map("sales_can_claim_unassigned")
  salesCanExport            Boolean @default(false) @map("sales_can_export")
  salesCanSeeOthersAttempts Boolean @default(false) @map("sales_can_see_others_attempts")
  /// Whether Sales may move a lead into a WON or LOST stage. Off by default: the numbers a
  /// business reports on shouldn't be self-declared.
  salesCanCloseLeads        Boolean @default(false) @map("sales_can_close_leads")
  salesCanEditCustomFields  Boolean @default(false) @map("sales_can_edit_custom_fields")

  /// The leads table's column layout — an ordered array of
  /// `{ key: "builtin:name" | "custom:<definitionId>", visible, width }`.
  ///
  /// One home for the whole layout, deliberately. Splitting visibility across this and a flag on
  /// each field definition would give two places to disagree about whether a column shows, and
  /// nothing to arbitrate between them. Global rather than per-person: an admin composes one
  /// table for the team.
  leadsTableColumns Json @default("[]") @map("leads_table_columns")

  /// Default action for an imported row whose email already exists: enrich | log | overwrite | skip.
  importDefaultMatchAction String  @default("enrich") @map("import_default_match_action") @db.VarChar(16)
  importMaxRows            Int     @default(5000) @map("import_max_rows")
  importAllowOverwrite     Boolean @default(true) @map("import_allow_overwrite")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("lead_settings")
}

/// One spreadsheet upload. Keeps the provenance of imported contacts, so "where did this
/// person come from?" has an answer months later.
model ImportBatch {
  id       String @id @default(uuid()) @db.Uuid
  filename String @db.VarChar(255)

  importedById String?     @map("imported_by_id") @db.Uuid
  importedBy   TeamMember? @relation(fields: [importedById], references: [id], onDelete: SetNull)

  createdCount  Int @default(0) @map("created_count")
  enrichedCount Int @default(0) @map("enriched_count")
  loggedCount   Int @default(0) @map("logged_count")
  skippedCount  Int @default(0) @map("skipped_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  enquiries Enquiry[]
  /// The contacts this file *created*, which is a smaller set than the enquiries it wrote — a row
  /// matching someone already here logs an enquiry against them without changing where they came
  /// from. "Everyone from the trade-show list" means this one.
  originatedContacts Contact[]

  @@index([createdAt])
  @@map("import_batches")
}

/// An immutable published snapshot. Append-only: publishing writes a new row, it never
/// updates an old one, so every release stays inspectable and restorable.
model ContentRelease {
  id               String   @id @default(uuid()) @db.Uuid
  /// Monotonic, human-readable release number. v1, v2, v3…
  version          Int      @unique
  /// The whole site payload, shaped exactly like the site's TS arrays.
  payload          Json
  /// Optional note from whoever published ("fixed the FAQ typo").
  note             String?  @db.VarChar(200)
  /// Email of the admin who pressed Publish.
  publishedBy      String?  @map("published_by") @db.VarChar(320)
  publishedAt      DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  /// Outcome of pinging the site's revalidate hook: skipped | ok | failed.
  /// "skipped" is the expected value until the site is actually wired up.
  revalidateStatus String?  @map("revalidate_status") @db.VarChar(16)
  revalidateDetail String?  @map("revalidate_detail")

  @@index([publishedAt])
  @@map("content_releases")
}
